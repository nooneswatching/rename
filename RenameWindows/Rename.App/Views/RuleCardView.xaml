<UserControl x:Class="Rename.App.Views.RuleCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Rename.Core.Models;assembly=Rename.Core">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="FieldGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
        </DataTemplate>

        <!-- One editor per rule type; ContentControl picks the template from the rule's runtime type. -->
        <DataTemplate DataType="{x:Type core:PrefixRule}">
            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Text" />
                <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:SuffixRule}">
            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Text" />
                <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:FindReplaceRule}">
            <StackPanel>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Find" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Replace" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <CheckBox Content="Case sensitive" FontSize="12" Margin="0,4,0,0" IsChecked="{Binding CaseSensitive}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:RegexFindReplaceRule}">
            <StackPanel>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pattern" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Text="Invalid regex pattern" FontSize="12" Margin="88,0,0,2"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Visibility="{Binding IsPatternValid, Converter={StaticResource InverseBoolToVisibility}}" />
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Replacement" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:NumberSequenceRule}">
            <StackPanel>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Start" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Step" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Step, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Digits (min)" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Digits, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Position" />
                    <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static core:EnumLabels.NumberPositions}"
                              SelectedItem="{Binding Position}" ItemTemplate="{StaticResource EnumItem}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:ChangeCaseRule}">
            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Case" />
                <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static core:EnumLabels.CaseStyles}"
                          SelectedItem="{Binding Style}" ItemTemplate="{StaticResource EnumItem}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:InsertAtRule}">
            <StackPanel>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Text" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="At position" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Index, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:RemoveRangeRule}">
            <StackPanel>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="From position" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding From, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Characters" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:ChangeExtensionRule}">
            <Grid Style="{StaticResource FieldGrid}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Extension" />
                <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:DateBasedRule}">
            <StackPanel>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Format" ToolTip="e.g. yyyy-MM-dd or yyyyMMdd_HHmm" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. yyyy-MM-dd" />
                </Grid>
                <Grid Style="{StaticResource FieldGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Date source" />
                    <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static core:EnumLabels.DateSources}"
                              SelectedItem="{Binding Source}" ItemTemplate="{StaticResource EnumItem}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:TemplateRule}">
            <StackPanel>
                <TextBox Style="{StaticResource Field}" Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                         ToolTip="Use {name} for the current name and {n} for a sequence number, e.g. Holiday_{n} or {name}_{n}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Current name" FontSize="12" Padding="8,3" MinHeight="0" Margin="0,0,6,0" Click="OnInsertNameToken" />
                    <Button Content="Number" FontSize="12" Padding="8,3" MinHeight="0" Click="OnInsertNumberToken" />
                </StackPanel>
                <Grid Margin="0,8,0,0" Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Start" />
                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Margin="0,0,12,0" Text="{Binding NumberStart, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Digits" />
                    <TextBox Grid.Column="3" Style="{StaticResource Field}" Text="{Binding NumberDigits, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
            <!-- Header: grip, enabled toggle, title, collapse, delete -->
            <Grid Margin="8,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE700;" FontSize="12" Margin="0,0,8,0"
                           Cursor="SizeAll" Background="Transparent" ToolTip="Drag to reorder"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" MouseLeftButtonDown="OnGripDown" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                          ToolTip="Enable or disable this rule" />
                <TextBlock Grid.Column="2" Text="{Binding Rule.DisplayName}" FontSize="13" FontWeight="Medium"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Grid.Column="3" Style="{StaticResource PlainButton}" Click="OnToggleExpanded" ToolTip="Show or hide settings">
                    <TextBlock FontSize="10">
                        <TextBlock.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                <Setter Property="Text" Value="&#xE70D;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="&#xE70E;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Resources>
                    </TextBlock>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource PlainButton}" Click="OnDelete" ToolTip="Remove rule">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE711;" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding Rule}" Margin="10,8" Focusable="False"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
