<UserControl x:Class="Rename.App.Views.RulesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Rename.App.Views"
             xmlns:core="clr-namespace:Rename.Core.Models;assembly=Rename.Core">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="38" Margin="12,0">
            <TextBlock Style="{StaticResource PanelHeaderText}" Text="Rename Rules" HorizontalAlignment="Left" />
            <Button x:Name="AddButton" Style="{StaticResource PlainButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnAddClick" ToolTip="Add a rule">
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" />
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{x:Static core:RuleCatalog.Templates}" MenuItem.Click="OnAddRuleClick">
                        <ContextMenu.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ContextMenu.ItemTemplate>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                        Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVisibility}}">
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE90F;" FontSize="56" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Add a rule to start renaming" FontSize="14" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer x:Name="RulesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding Rules.Count, Converter={StaticResource NonZeroToVisibility}}">
                <Grid x:Name="RulesHost" Background="Transparent" AllowDrop="True"
                      MinHeight="{Binding ViewportHeight, ElementName=RulesScroll}"
                      PreviewMouseMove="OnHostMouseMove" PreviewMouseLeftButtonUp="OnHostMouseUp"
                      DragOver="OnHostDragOver" DragLeave="OnHostDragLeave" Drop="OnHostDrop">
                    <ItemsControl x:Name="RulesItems" ItemsSource="{Binding Rules}" Padding="8,6" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:RuleCardView Margin="0,3" RemoveRequested="OnRemoveRule" DragHandlePressed="OnRuleGripPressed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Canvas x:Name="RulesOverlay" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
