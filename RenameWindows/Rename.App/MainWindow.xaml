<Window x:Class="Rename.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rename.App.Views"
        Title="Rename"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/Assets/Rename.ico"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Height="48">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                <Button Click="OnOpenFolder" ToolTip="Open Folder (Ctrl+O)" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;" Margin="0,0,8,0" />
                        <TextBlock Text="Open Folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnAddFiles" ToolTip="Add Files (Ctrl+Shift+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Add Files" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"
                    Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip="Undo last rename (Ctrl+Z)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A7;" Margin="0,0,8,0" />
                    <TextBlock Text="Undo" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- Preview bar -->
        <Border DockPanel.Dock="Bottom" Height="48" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <views:PreviewBarView ApplyRequested="OnApplyRequested" />
        </Border>

        <!-- Sidebar | Canvas | Rules -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" MaxWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="290" MinWidth="240" MaxWidth="320" />
            </Grid.ColumnDefinitions>

            <views:SidebarView Grid.Column="0" />

            <Grid Grid.Column="1" Width="5">
                <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <GridSplitter Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
            </Grid>

            <views:OrderingCanvasView Grid.Column="2" />

            <Grid Grid.Column="3" Width="5">
                <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <GridSplitter Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
            </Grid>

            <views:RulesPanelView Grid.Column="4" />
        </Grid>
    </DockPanel>
</Window>
